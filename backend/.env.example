# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sistema_da
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_da
DB_USER=postgres
DB_PASSWORD=password

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api

# JWT
# Obrigatório: 32+ caracteres aleatórios (openssl rand -hex 32). O servidor não inicia sem ele.
JWT_SECRET=
JWT_EXPIRY=8h
# URL pública do front-end, usada no link de redefinição de senha
APP_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

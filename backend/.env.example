# Banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_da
# Testes (npm test recria este banco a cada execução — nunca aponte para produção)
TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_da_test

# Servidor
NODE_ENV=development
PORT=3000
# Atrás de proxy reverso (HTTPS): true ou número de saltos
TRUST_PROXY=

# JWT — obrigatório: 32+ caracteres aleatórios (openssl rand -hex 32). O servidor não inicia sem ele.
JWT_SECRET=
JWT_EXPIRY=8h

# URL pública do front-end (links de redefinição de senha e convites)
APP_URL=http://localhost:5173
# Origens permitidas (CORS), separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# E-mail (SMTP institucional). Sem SMTP fora de produção, as mensagens saem no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nao-responda@camara.gov.br

# Almoxarifado — leitura de RME/BRM no Google Drive (conta de serviço, somente leitura)
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_FOLDER_ID_RME=
DRIVE_FOLDER_ID_BRM=
# Pasta para anexos enviados (PDFs de legislações etc.)
UPLOAD_DIR=uploads
